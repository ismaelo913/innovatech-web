---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import HeroB from '../components/home/HeroB.astro';
import ServicesPreview from '../components/home/ServicesPreview.astro';
import B2BSection from '../components/home/B2BSection.astro';
import ProjectsShowcase from '../components/home/ProjectsShowcase.astro';
import CTASection from '../components/home/CTASection.astro';
import { SITE } from '../lib/constants';
---

<BaseLayout
  title={`${SITE.name} | ${SITE.tagline}`}
  description={SITE.description}
>
  <HeroB />
  <ServicesPreview />
  <B2BSection />
  <ProjectsShowcase />
  <CTASection />
</BaseLayout>
