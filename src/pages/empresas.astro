---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import { Image } from 'astro:assets';
import { SITE } from '../lib/constants';
import { CLIENTS, logoSize } from '../lib/clients';

// Íconos de línea (trazo 1,5, como los de /servicios y /nosotros): casco,
// edificio de oficinas y local comercial.
const icps = [
  {
    icon: 'M12 3v1m0 0a7 7 0 017 7v2H5v-2a7 7 0 017-7zm-9 10h18v2a2 2 0 01-2 2H5a2 2 0 01-2-2v-2zm4 4v2m10-2v2',
    title: 'Constructoras y subcontratistas',
    desc: 'Necesitas cuadrillas especializadas para partidas específicas: albañilería, terminaciones, estructura. Llegamos con contrato, mutualidad vigente, EPP propio y supervisor en terreno.',
  },
  {
    icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4',
    title: 'Inmobiliarias y project managers',
    desc: 'Gestionas múltiples proyectos y necesitas subcontratistas que documenten, cumplan plazo y emitan factura electrónica. Trabajamos con F30-1 mensual y acceso directo al supervisor.',
  },
  {
    icon: 'M13.5 21v-7.5a.75.75 0 0 1 .75-.75h3a.75.75 0 0 1 .75.75V21m-4.5 0H2.36m11.14 0H18m0 0h3.64m-1.39 0V9.349M3.75 21V9.349m0 0a3.001 3.001 0 0 0 3.75-.615A2.993 2.993 0 0 0 9.75 9.75c.896 0 1.7-.393 2.25-1.016a2.993 2.993 0 0 0 2.25 1.016c.896 0 1.7-.393 2.25-1.015a3.001 3.001 0 0 0 3.75.614m-16.5 0a3.004 3.004 0 0 1-.621-4.72l1.189-1.19A1.5 1.5 0 0 1 5.378 3h13.243a1.5 1.5 0 0 1 1.06.44l1.19 1.189a3 3 0 0 1-.621 4.72M6.75 18h3.75a.75.75 0 0 0 .75-.75V13.5a.75.75 0 0 0-.75-.75H6.75a.75.75 0 0 0-.75.75v3.75c0 .414.336.75.75.75Z',
    title: 'Empresas con locales y oficinas',
    desc: 'Necesitas remodelar tu espacio comercial sin detener la operación. Planificamos en fases, trabajamos en horarios acordados y entregamos presupuesto escrito antes de empezar.',
  },
];

const docs = [
  { label: 'RUT activo SII + giro construcción', detail: 'Actividades 4100–4299 / 4520' },
  { label: 'Contratos de trabajo firmados', detail: 'Todos los trabajadores en obra' },
  { label: 'EPP completo propio', detail: 'Casco, zapatos, guantes, arnés' },
  { label: 'Supervisor en terreno propio', detail: 'No depende del mandante para coordinar' },
  { label: 'Factura electrónica habilitada', detail: 'Recupera crédito fiscal IVA' },
  { label: 'F30-1 mensual disponible', detail: 'Cumplimiento laboral documentado' },
];

const steps = [
  { num: '01', title: 'Cuéntanos el proyecto', desc: 'Llena el formulario o escríbenos directo. Describimos el alcance, las partidas y el plazo estimado.' },
  { num: '02', title: 'Visita técnica gratuita', desc: 'Un supervisor va al lugar. Evalúa el estado actual y toma mediciones exactas sin costo.' },
  { num: '03', title: 'Propuesta escrita en 48 h', desc: 'Desglose por partidas, precio total, plazo comprometido y condiciones de pago.' },
  { num: '04', title: 'Inicio con contrato firmado', desc: 'Anticipo máximo 30%. Supervisor en terreno todos los días. Informes de avance cuando los necesitas.' },
];

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Subcontrato de construcción para empresas",
  "provider": {
    "@type": "LocalBusiness",
    "name": "Innovatech Construcciones",
    "url": "https://innovatechconstrucciones.cl",
    "telephone": "+56938905488",
    "areaServed": "Región Metropolitana, Chile"
  },
  "description": "Cuadrillas especializadas para constructoras e inmobiliarias en Santiago. Documentación Art. 183-A, mutualidad, EPP y factura electrónica incluidos.",
  "areaServed": "Santiago, Región Metropolitana"
});
---

<BaseLayout
  title="Subcontratista para constructoras e inmobiliarias"
  description="Cuadrillas con documentación completa: contratos, mutualidad, EPP y factura electrónica. Cumplimos el Art. 183-A desde el primer día. Santiago RM."
  fonts={['display', 'mono']}
>
  <script type="application/ld+json" set:html={schema} />

  <!-- Hero B2B -->
  <section class="py-20 sm:py-28 bg-neutral-950 text-white overflow-hidden relative border-b-brutal-invert">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,oklch(30%_0_0)_1px,transparent_1px),linear-gradient(to_bottom,oklch(30%_0_0)_1px,transparent_1px)] bg-[size:3rem_3rem] opacity-20 pointer-events-none"></div>
    <Container>
      <div class="max-w-3xl mx-auto text-center relative z-10">
        <span class="inline-block text-xs font-bold tracking-widest uppercase text-primary-500 mb-5 border-brutal-invert px-3 py-1">
          Para constructoras, inmobiliarias y empresas
        </span>
        <h1 class="font-display text-[clamp(2.25rem,13vw,3rem)] sm:text-6xl lg:text-7xl font-black uppercase leading-tight mb-6">
          Obra que avanza.<br class="hidden sm:block" />
          <span class="text-primary-500">Documentación que protege.</span>
        </h1>
        <p class="text-lg text-neutral-300 font-light max-w-2xl mx-auto mb-10 leading-relaxed">
          Llegamos con contratos firmados, EPP propio, supervisor en terreno y factura electrónica. Trabajamos para constructoras, inmobiliarias y project managers en toda la Región Metropolitana.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="#contacto-empresas"
            class="inline-flex items-center gap-2 px-7 py-3.5 rounded-none border-brutal-invert bg-primary-600 text-white font-bold text-sm shadow-[4px_4px_0_0_rgba(255,255,255,0.25)] hover:bg-white hover:text-neutral-950 hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[2px_2px_0_0_rgba(255,255,255,0.25)] transition-[background-color,color,transform,box-shadow] duration-200 ease-[var(--ease-out)]"
          >
            Solicitar propuesta
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
          <a
            href="/recursos/checklist-subcontratistas"
            class="inline-flex items-center gap-2 px-7 py-3.5 border-brutal-invert text-neutral-200 font-bold text-sm uppercase tracking-wide hover:bg-white/5 hover:text-white transition-colors"
          >
            Ver checklist legal gratuito
          </a>
        </div>
      </div>
    </Container>
  </section>

  <!-- Stat bar -->
  <section class="bg-neutral-950 text-white">
    <div class="grid grid-cols-2 sm:grid-cols-4 divide-x divide-y sm:divide-y-0 divide-white/15">
        {[
          { stat: 'Art. 183-A', label: 'Documentación en regla desde día 1' },
          { stat: 'F30-1', label: 'Certificado cumplimiento laboral disponible' },
          { stat: 'EPP', label: 'Equipo de protección propio incluido' },
          { stat: 'IVA', label: 'Factura electrónica incluida' },
        ].map(({ stat, label }) => (
          <div class="py-6 px-6 text-center">
            <div class="text-2xl font-black text-primary-500 mb-1">{stat}</div>
            <div class="text-xs text-neutral-400 leading-snug">{label}</div>
          </div>
        ))}
    </div>
  </section>

  <!-- A quién servimos -->
  <section class="py-16 sm:py-20 bg-surface-alt border-b-brutal">
    <Container>
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="font-display text-3xl sm:text-4xl font-black uppercase leading-tight text-neutral-950 mb-3">¿Para quién trabajamos?</h2>
          <p class="text-accent-500 font-light">Entendemos que cada tipo de empresa tiene necesidades distintas.</p>
        </div>
        <div class="space-y-4">
          {icps.map(({ icon, title, desc }) => (
            <div class="flex gap-5 p-6 border-brutal bg-white hover-bg-brand transition-colors">
              <div class="w-12 h-12 border-brutal bg-primary-50 flex items-center justify-center shrink-0" aria-hidden="true">
                <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d={icon} />
                </svg>
              </div>
              <div>
                <h3 class="font-bold text-neutral-950 mb-1.5">{title}</h3>
                <p class="text-sm font-light text-accent-500 leading-relaxed">{desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </Container>
  </section>

  <!-- Capacidad operacional -->
  <section class="py-16 sm:py-20 border-b-brutal">
    <Container>
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="font-display text-3xl sm:text-4xl font-black uppercase leading-tight text-neutral-950 mb-3">Capacidad operacional</h2>
          <p class="text-accent-500 font-light max-w-xl mx-auto">Lo que puedes esperar cuando trabajas con Innovatech como subcontratista.</p>
        </div>
        <div class="grid sm:grid-cols-2 gap-5">
          {[
            { title: 'Remodelaciones residenciales', detail: 'Cocinas, baños, living, dormitorios. Obras hasta 200 m².' },
            { title: 'Remodelaciones comerciales', detail: 'Locales, oficinas y espacios corporativos.' },
            { title: 'Obra gruesa', detail: 'Fundaciones, estructura, albañilería y hormigón.' },
            { title: 'Terminaciones', detail: 'Revestimientos, pintura, pisos, cielos y carpintería.' },
            { title: 'Ampliaciones', detail: 'Segundos pisos, extensiones y nuevas áreas.' },
            { title: 'Electricidad y montaje eléctrico', detail: 'Salas eléctricas, tableros, baja y media tensión (BT/MT).' },
            { title: 'Supervisión técnica', detail: 'Supervisor propio en terreno todos los días de obra.' },
          ].map(({ title, detail }) => (
            <div class="p-5 border-brutal bg-surface-alt">
              <div class="font-bold text-neutral-950 text-sm mb-1">{title}</div>
              <div class="text-xs text-accent-500">{detail}</div>
            </div>
          ))}
        </div>
      </div>
    </Container>
  </section>

  <!-- Documentación Art. 183-A -->
  <section class="py-16 sm:py-20 bg-neutral-950 text-white border-y-brutal-invert">
    <Container>
      <div class="max-w-3xl mx-auto">
        <div class="mb-10">
          <span class="text-xs font-bold tracking-widest uppercase text-primary-500">Cumplimiento legal</span>
          <h2 class="font-display text-3xl sm:text-4xl font-black uppercase leading-tight mt-2 mb-3">
            Llegamos con la documentación que la ley exige
          </h2>
          <p class="text-neutral-400 font-light text-sm max-w-xl">
            El Art. 183-A del Código del Trabajo te hace responsable solidario si tu subcontratista no cumple. Con Innovatech eso no ocurre — te entregamos cada documento antes de iniciar faenas.
          </p>
        </div>
        <div class="grid sm:grid-cols-2 gap-3">
          {docs.map(({ label, detail }) => (
            <div class="flex items-start gap-3 p-4 border-brutal-invert bg-white/5">
              <svg class="w-5 h-5 text-primary-500 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <div>
                <div class="text-sm font-semibold text-white">{label}</div>
                <div class="text-xs text-neutral-400 mt-0.5">{detail}</div>
              </div>
            </div>
          ))}
        </div>
        <div class="mt-8 p-5 border border-white/15 border-l-4 border-l-primary-500 bg-white/5">
          <p class="text-xs text-neutral-300 leading-relaxed">
            <strong class="text-primary-500">Multas Art. 183-A:</strong> Un mandante sin control puede enfrentar sanciones de <strong>5 a 150 UTM</strong> (aprox. CLP $310.000 – $9.350.000 al 2026) más demandas laborales directas. Exige el F30-1 mensual a todos tus subcontratistas.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <!-- Cómo funciona -->
  <section class="py-16 sm:py-20 border-b-brutal">
    <Container>
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="font-display text-3xl sm:text-4xl font-black uppercase leading-tight text-neutral-950 mb-3">Cómo funciona el proceso</h2>
          <p class="text-accent-500 font-light">Sin demoras ni ambigüedades.</p>
        </div>
        <div class="grid sm:grid-cols-2 gap-6">
          {steps.map(({ num, title, desc }) => (
            <div class="flex gap-4">
              <div class="shrink-0 w-10 h-10 border-brutal bg-neutral-950 text-white flex items-center justify-center text-xs font-mono font-bold">
                {num}
              </div>
              <div>
                <div class="font-bold text-neutral-950 text-sm mb-1">{title}</div>
                <div class="text-xs text-accent-500 leading-relaxed">{desc}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </Container>
  </section>

  <!-- Formulario de contacto B2B -->
  <section id="contacto-empresas" class="py-16 sm:py-20 border-b-brutal">
    <Container>
      <div class="max-w-2xl mx-auto">
        <div class="mb-10">
          <h2 class="font-display text-3xl sm:text-4xl font-black uppercase leading-tight text-neutral-950 mb-3">Solicita una propuesta</h2>
          <p class="text-accent-500 font-light text-sm">Cuéntanos el proyecto. Un asesor te responde en menos de 24 horas hábiles.</p>
        </div>

        <!-- Sin JavaScript, el formulario al menos abre el chat de WhatsApp. -->
        <form id="b2b-form" class="space-y-5" action={`https://wa.me/${SITE.whatsapp}`}>
          <div class="hidden" aria-hidden="true">
            <input type="text" name="_honey" tabindex="-1" autocomplete="off" />
          </div>
          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="b2b-empresa" class="block text-sm font-bold text-neutral-700 mb-1.5">Empresa</label>
              <input type="text" id="b2b-empresa" name="empresa" required
                class="w-full px-4 py-2.5 border-brutal text-sm focus:outline-none focus:ring-2 focus:ring-primary-400 bg-white"
                placeholder="Constructora XYZ SpA" />
            </div>
            <div>
              <label for="b2b-nombre" class="block text-sm font-bold text-neutral-700 mb-1.5">Tu nombre</label>
              <input type="text" id="b2b-nombre" name="nombre" required
                class="w-full px-4 py-2.5 border-brutal text-sm focus:outline-none focus:ring-2 focus:ring-primary-400 bg-white"
                placeholder="Carlos Fuentes" />
            </div>
            <div>
              <label for="b2b-telefono" class="block text-sm font-bold text-neutral-700 mb-1.5">Teléfono</label>
              <input type="tel" id="b2b-telefono" name="telefono" required
                class="w-full px-4 py-2.5 border-brutal text-sm focus:outline-none focus:ring-2 focus:ring-primary-400 bg-white"
                placeholder="+56 9 1234 5678" />
            </div>
            <div>
              <label for="b2b-email" class="block text-sm font-bold text-neutral-700 mb-1.5">Email</label>
              <input type="email" id="b2b-email" name="email" required
                class="w-full px-4 py-2.5 border-brutal text-sm focus:outline-none focus:ring-2 focus:ring-primary-400 bg-white"
                placeholder="carlos@constructora.cl" />
            </div>
          </div>
          <div>
            <label for="b2b-tipo" class="block text-sm font-bold text-neutral-700 mb-1.5">Tipo de empresa</label>
            <select id="b2b-tipo" name="tipo_empresa"
              class="w-full px-4 py-2.5 border-brutal text-sm focus:outline-none focus:ring-2 focus:ring-primary-400 bg-white">
              <option value="constructora">Empresa constructora</option>
              <option value="inmobiliaria">Inmobiliaria</option>
              <option value="pm">Project manager independiente</option>
              <option value="empresa">Empresa con local / oficina</option>
              <option value="otro">Otro</option>
            </select>
          </div>
          <div>
            <label for="b2b-proyecto" class="block text-sm font-bold text-neutral-700 mb-1.5">Describe el proyecto</label>
            <textarea id="b2b-proyecto" name="proyecto" rows={4}
              class="w-full px-4 py-2.5 border-brutal text-sm focus:outline-none focus:ring-2 focus:ring-primary-400 bg-white resize-y"
              placeholder="Tipo de trabajo, m² aproximados, comuna, plazo estimado, partidas específicas que necesitas..."></textarea>
          </div>
          <div class="pt-2">
            <button type="submit"
              class="inline-flex items-center gap-2 px-7 py-3.5 rounded-none border-brutal bg-primary-600 text-white font-bold text-sm shadow-[4px_4px_0_0_var(--color-neutral-950)] hover:bg-neutral-950 hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[2px_2px_0_0_var(--color-neutral-950)] disabled:opacity-50 disabled:cursor-not-allowed transition-[background-color,transform,box-shadow] duration-200 ease-[var(--ease-out)] cursor-pointer">
              <span data-b2b-label>Enviar solicitud</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
              </svg>
            </button>
            <p class="text-xs text-neutral-600 mt-3">Respondemos en menos de 24 horas hábiles. Sin costo ni compromiso.</p>
          </div>
        </form>

        <div id="b2b-success" hidden class="py-12 px-6 text-center border-2 border-green-700 bg-green-50">
          <h3 tabindex="-1" class="text-xl font-black uppercase text-green-900 mb-2 outline-none">¡Solicitud recibida!</h3>
          <p class="text-green-800">Un asesor te contactará en menos de 24 horas hábiles para coordinar la visita técnica.</p>
        </div>

        <!-- Respaldo si el correo no sale (mismo diseño que WhatsAppFallback.tsx) -->
        <div id="b2b-fallback" hidden class="mt-6 p-6 border border-neutral-900 border-l-4 border-l-[#25D366] bg-surface-alt">
          <h3 tabindex="-1" class="font-bold uppercase text-neutral-950 mb-2 outline-none">Falta un paso: envíanos el mensaje por WhatsApp</h3>
          <p class="text-sm text-accent-500 mb-4">No pudimos enviar el formulario por correo. Tu mensaje ya va escrito: abre WhatsApp y toca Enviar.</p>
          <a
            id="b2b-whatsapp"
            href={`https://wa.me/${SITE.whatsapp}`}
            target="_blank"
            rel="noopener noreferrer"
            data-lead-source="formulario_empresas_whatsapp"
            class="inline-flex items-center gap-2 px-5 py-2.5 border-brutal bg-[#25D366] text-neutral-950 font-bold text-sm hover:bg-neutral-950 hover:text-white transition-colors"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Abrir WhatsApp y enviar
          </a>
          <p class="text-xs text-neutral-600 mt-4">
            ¿Prefieres otra vía? Llámanos al <a href={`tel:${SITE.phone}`} class="font-bold text-neutral-950 underline">{SITE.phone}</a>
            o escríbenos a <a href={`mailto:${SITE.email}`} class="font-bold text-neutral-950 underline wrap-anywhere">{SITE.email}</a>.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <!-- Clientes que confían en Innovatech -->
  <section class="py-16 sm:py-20 bg-surface-alt border-b-brutal">
    <Container>
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="font-display text-3xl sm:text-4xl font-black uppercase leading-tight text-neutral-950 mb-3">Han confiado en nosotros</h2>
          <p class="text-accent-500 font-light text-sm">Trabajamos junto a constructoras, inmobiliarias, distribuidores eléctricos y empresas del sector industrial.</p>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 border-t-brutal border-l-brutal bg-white">
          {CLIENTS.map(({ nombre, logo }) => {
            const size = logoSize(logo, 52, 130);
            return (
              <div class="reveal flex flex-col items-center justify-between gap-3 p-5 border-r-brutal border-b-brutal min-h-[130px] group">
                <div class="w-full flex items-center justify-center flex-1 min-h-16">
                  <Image
                    src={logo}
                    alt={`Logo ${nombre}`}
                    width={size.width}
                    height={size.height}
                    densities={[1, 2]}
                    class="max-w-[85%] h-auto object-contain client-logo"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <span class="text-[11px] font-medium text-center leading-tight w-full text-neutral-500 group-hover:text-neutral-800 transition-colors">
                  {nombre}
                </span>
              </div>
            );
          })}
        </div>
      </div>
    </Container>
  </section>

  <!-- Cross-link recursos -->
  <section class="py-12 bg-surface-alt">
    <Container>
      <div class="max-w-2xl mx-auto text-center">
        <p class="text-sm text-accent-500 mb-4">¿Quieres saber qué documentación exigirle a cualquier subcontratista?</p>
        <a href="/recursos/checklist-subcontratistas"
          class="inline-flex items-center gap-2 text-sm font-bold uppercase tracking-wide text-primary-700 hover:text-primary-800 transition-colors">
          Descargar checklist gratuito del mandante
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </Container>
  </section>
</BaseLayout>

<script>
  // La solicitud B2B llega por correo (EmailJS, misma plantilla que el
  // formulario de contacto). Antes solo abría WhatsApp: si la persona no
  // tocaba Enviar —o estaba en un PC sin WhatsApp Web— la solicitud se perdía.
  // Si el correo falla, se ofrece el mismo mensaje por WhatsApp.
  import emailjs from '@emailjs/browser';
  import { EMAILJS_CONFIG, isEmailConfigured } from '../lib/emailjs';
  import { trackLead } from '../lib/analytics';
  import { Image } from 'astro:assets';
import { SITE } from '../lib/constants';
import { CLIENTS, logoSize } from '../lib/clients';
  import { whatsappUrl } from '../lib/utils';

  const form = document.getElementById('b2b-form') as HTMLFormElement;
  const success = document.getElementById('b2b-success');
  const fallback = document.getElementById('b2b-fallback');
  const whatsappLink = document.getElementById('b2b-whatsapp') as HTMLAnchorElement | null;
  const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
  const submitLabel = form.querySelector<HTMLElement>('[data-b2b-label]');

  function setSending(sending: boolean) {
    if (submit) submit.disabled = sending;
    if (submitLabel) submitLabel.textContent = sending ? 'Enviando...' : 'Enviar solicitud';
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    const fd = new FormData(form);
    if (fd.get('_honey')) return;

    const empresa = fd.get('empresa') as string;
    const nombre = fd.get('nombre') as string;
    const telefono = fd.get('telefono') as string;
    const email = fd.get('email') as string;
    const tipoSelect = form.elements.namedItem('tipo_empresa') as HTMLSelectElement;
    const tipo = tipoSelect.selectedOptions[0]?.text ?? '';
    const proyecto = (fd.get('proyecto') as string) || 'Sin descripción';

    setSending(true);
    if (fallback) fallback.hidden = true;

    if (isEmailConfigured()) {
      try {
        await emailjs.send(
          EMAILJS_CONFIG.serviceId,
          EMAILJS_CONFIG.contactTemplateId,
          {
            name: `${nombre} (${empresa})`,
            phone: telefono,
            email,
            service: `Propuesta para empresa: ${tipo}`,
            message: `Empresa: ${empresa}\nTipo: ${tipo}\nContacto: ${nombre}\n\nProyecto:\n${proyecto}`,
          },
          { publicKey: EMAILJS_CONFIG.publicKey },
        );
        trackLead('formulario_empresas');
        form.hidden = true;
        if (success) {
          success.hidden = false;
          success.querySelector('h3')?.focus();
        }
        return;
      } catch {
        // Sigue al respaldo por WhatsApp
      }
    }

    setSending(false);
    if (whatsappLink) {
      whatsappLink.href = whatsappUrl(
        SITE.whatsapp,
        `Hola Innovatech, solicito una propuesta para empresa.\n\n🏢 Empresa: ${empresa}\n👤 Contacto: ${nombre}\n📱 Teléfono: ${telefono}\n📧 Email: ${email}\n🏷️ Tipo: ${tipo}\n\n📝 Proyecto:\n${proyecto}`,
      );
    }
    if (fallback) {
      fallback.hidden = false;
      fallback.querySelector('h3')?.focus();
    }
  });
</script>
