---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import ProcessBlueprint from '../components/home/ProcessBlueprint.astro';
import ServicesPreview from '../components/home/ServicesPreview.astro';
import ClientsSection from '../components/home/ClientsSection.astro';
import TestimonialsSection from '../components/home/TestimonialsSection.astro';
import B2BSection from '../components/home/B2BSection.astro';
import ProjectsReveal from '../components/home/ProjectsReveal.astro';
import CTASection from '../components/home/CTASection.astro';
import { SITE } from '../lib/constants';

// Google usa WebSite (solo en la home) para el nombre del sitio que muestra
// en los resultados.
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.fullName,
  alternateName: [SITE.name, 'innovatechconstrucciones.cl'],
  url: `${SITE.url}/`,
};
---

<BaseLayout
  title="Construcción y Montaje Eléctrico en Santiago"
  description={SITE.description}
  schema={websiteSchema}
  fonts={['display', 'stencil']}
  gsap
>
  <Hero />
  <ProcessBlueprint />
  <ServicesPreview />
  <ClientsSection />
  <TestimonialsSection />
  <B2BSection />
  <ProjectsReveal />
  <CTASection />
</BaseLayout>

<script src="../scripts/home-animations.js"></script>
