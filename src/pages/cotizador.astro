---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import CotizadorForm from '../components/cotizador/CotizadorForm.tsx';
---

<BaseLayout
  title="Cotizador"
  description="Solicita una cotización para tu proyecto de construcción con Innovatech. Calidad que se ve, seguridad que se siente."
>
  <section class="py-16 sm:py-20 bg-background border-b-brutal">
    <Container>
      <div class="max-w-2xl mx-auto text-center">
        <span class="inline-block text-sm font-bold tracking-widest uppercase text-primary-600 mb-4">
          Cotizador
        </span>
        <h1 class="text-3xl sm:text-4xl font-black uppercase text-neutral-950 tracking-tight leading-tight mb-4">
          Solicita tu cotización
        </h1>
        <p class="text-lg font-light text-accent-500">
          Cuéntanos tu proyecto o arma una estimación trabajo por trabajo. La cotización real siempre se entrega tras la visita en terreno.
        </p>
      </div>
    </Container>
  </section>

  <!-- Cómo funciona -->
  <section class="py-12 border-b-brutal">
    <Container narrow>
      <h2 class="text-lg font-black uppercase text-neutral-950 mb-8 text-center">¿Qué pasa después de contactarnos?</h2>
      <div class="grid sm:grid-cols-4 gap-6 text-center">
        {[
          { num: '01', title: 'Cuéntanos qué necesitas', desc: 'Llena el formulario o escríbenos por WhatsApp. Tarda menos de 3 minutos.' },
          { num: '02', title: 'Visita técnica gratuita', desc: 'Un supervisor va a tu propiedad en Santiago. Evalúa el trabajo sin costo ni compromiso.' },
          { num: '03', title: 'Cotización por escrito en 24 h', desc: 'Recibes el desglose completo: qué incluye, cuánto cuesta y cuánto tiempo toma.' },
          { num: '04', title: 'Empezamos con contrato', desc: 'Si avanzas, firmamos antes de empezar. Anticipo máximo 30%. Supervisor presente todos los días.' },
        ].map(({ num, title, desc }) => (
          <div class="flex flex-col items-center gap-2">
            <div class="w-10 h-10 border-brutal bg-neutral-950 text-white flex items-center justify-center text-sm font-mono font-bold shrink-0">
              {num}
            </div>
            <p class="font-bold text-neutral-950 text-sm">{title}</p>
            <p class="text-xs text-accent-500 leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
      <p class="text-center text-xs text-neutral-400 mt-6">
        Si en algún momento tienes dudas durante la obra, tu supervisor es tu contacto directo. Nada pasa sin que lo sepas.
      </p>
    </Container>
  </section>

  <section class="py-section">
    <Container narrow>
      <CotizadorForm client:visible />
    </Container>
  </section>
</BaseLayout>
