---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
import BlueprintMarks from '../components/ui/BlueprintMarks.astro';
import { SITE, NAV_LINKS } from '../lib/constants';
---

<BaseLayout
  title="Página no encontrada"
  description="La página que buscas no existe o fue movida. Volvamos a terreno conocido."
>
  <section class="relative py-24 sm:py-32 bg-background overflow-hidden">
    <BlueprintMarks variant="light" class="hidden sm:block" />
    <Container narrow class="relative text-center">
      <span class="inline-flex items-center gap-2 text-xs font-bold tracking-[0.2em] uppercase text-primary-600 mb-6">
        <span class="w-6 h-px bg-primary-600"></span>
        Error 404
      </span>

      <h1 class="font-stencil text-[5rem] sm:text-[8rem] lg:text-[10rem] font-black leading-none text-neutral-950 mb-2">
        404
      </h1>

      <h2 class="font-display text-2xl sm:text-4xl font-black uppercase text-neutral-950 mb-6">
        Esta página no está en los planos
      </h2>

      <p class="text-lg text-neutral-600 max-w-xl mx-auto mb-10 leading-relaxed">
        El enlace que seguiste puede estar roto o la página fue movida. Volvamos a terreno conocido — desde ahí encuentras todo lo que necesitas.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-16">
        <Button href="/" size="lg" variant="primary">
          Volver al inicio
        </Button>
        <Button href="/cotizador" size="lg" variant="outline">
          Cotiza tu proyecto
        </Button>
      </div>

      <div class="border-brutal bg-surface-alt p-6 sm:p-8 text-left max-w-2xl mx-auto">
        <p class="text-xs font-bold tracking-[0.2em] uppercase text-neutral-500 mb-4">
          Páginas más buscadas
        </p>
        <ul class="grid grid-cols-2 sm:grid-cols-3 gap-3">
          {NAV_LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm font-bold text-neutral-950 hover:text-primary-600 transition-colors underline underline-offset-4 decoration-neutral-300 hover:decoration-primary-600"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <p class="text-sm text-neutral-500 mt-10">
        ¿Necesitas ayuda directa? Escríbenos a
        {' '}
        <a href={`mailto:${SITE.email}`} class="font-bold text-neutral-950 hover:text-primary-600 underline">{SITE.email}</a>
        {' '}o por{' '}
        <a href={`https://wa.me/${SITE.whatsapp}`} class="font-bold text-neutral-950 hover:text-primary-600 underline">WhatsApp</a>.
      </p>
    </Container>
  </section>
</BaseLayout>
