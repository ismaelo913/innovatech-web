---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import ServiceCard from '../../components/services/ServiceCard.astro';
import FeaturedServiceCard from '../../components/services/FeaturedServiceCard.astro';
import CTASection from '../../components/home/CTASection.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

const services = (await getCollection('services')).sort(
  (a, b) => a.data.order - b.data.order,
);
const [featured, secondary, ...rest] = services;
---

<BaseLayout
  title="Servicios"
  description="Servicios de construcción y montaje eléctrico en Santiago: electricidad, obra gruesa, terminaciones, ampliaciones y remodelaciones. Calidad que se ve, seguridad que se siente."
>
  <div class="bg-background border-b-brutal">
    <Container>
      <div class="pt-4">
        <Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: 'Servicios' }]} />
      </div>
    </Container>
  </div>

  <section class="py-16 sm:py-20 bg-background border-b-brutal">
    <Container>
      <SectionHeading
        label="Nuestros servicios"
        title="Calidad en cada etapa de tu obra"
        description="Cubrimos cada fase de la construcción con un equipo preparado y comprometido con el resultado que esperas."
      />
    </Container>
  </section>

  {featured && (
    <FeaturedServiceCard
      title={featured.data.title}
      short={featured.data.description}
      slug={featured.id}
      image={featured.data.image ?? '/images/projects/montaje-electrico-1.jpeg'}
    />
  )}

  <section class="py-section">
    <Container>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {secondary && (
          <ServiceCard
            title={secondary.data.title}
            description={secondary.data.description}
            icon={secondary.data.icon}
            slug={secondary.id}
            features={secondary.data.features}
            size="lg"
            class="md:col-span-2"
          />
        )}
        {rest.map((service) => (
          <ServiceCard
            title={service.data.title}
            description={service.data.description}
            icon={service.data.icon}
            slug={service.id}
            features={service.data.features}
          />
        ))}
      </div>
    </Container>
  </section>

  <CTASection />
</BaseLayout>

<script src="../../scripts/services-animations.js"></script>
