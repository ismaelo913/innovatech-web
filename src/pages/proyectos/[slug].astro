---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import ProjectGallery from '../../components/projects/ProjectGallery.tsx';
import { getCollection, render } from 'astro:content';
import { responsivePhoto } from '../../lib/projectPhotos';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const categoryLabels: Record<string, string> = {
  'remodelacion-residencial': 'Remodelación Residencial',
  'remodelacion-comercial':   'Remodelación Comercial',
  'obra-gruesa':              'Obra Gruesa',
  'terminaciones':            'Terminaciones',
  'ampliacion':               'Ampliación',
  'montaje-electrico':        'Montaje Eléctrico',
};

// Fotos de cada proyecto (archivos en src/assets/projects)
const projectImages: Record<string, string[]> = {
  'condominio-colina': ['colina-1.jpeg', 'colina-2.jpeg', 'colina-3.jpeg'],
  'condominio-las-condes': ['las-condes-1.jpeg', 'las-condes-2.jpeg', 'las-condes-3.jpeg', 'las-condes-4.jpeg'],
  'techumbre-terminaciones': ['techumbre-1.jpeg', 'techumbre-2.jpeg'],
  'mina-cmp-copiapo': Array.from({ length: 10 }, (_, i) => `mina-cmp-${i + 1}.jpeg`),
  'tableros-electricos-armados': Array.from({ length: 12 }, (_, i) => `tableros-${i + 1}.jpeg`),
  'montaje-electrico-industrial': ['montaje-electrico-1.jpeg', 'montaje-electrico-2.jpeg'],
};
// Un solo srcset por foto sirve a la portada, las miniaturas y el lightbox:
// cada <img> declara su propio `sizes` y el navegador elige el ancho.
const images = await Promise.all(
  (projectImages[project.id] || ['colina-1.jpeg']).map((file) => responsivePhoto(file, [480, 960, 1600])),
);

const allDetails = [
  { label: 'Ubicación', value: project.data.location },
  { label: 'Fecha', value: new Date(project.data.date).toLocaleDateString('es-CL', { year: 'numeric', month: 'long' }) },
];

const details = allDetails.filter(d => Boolean(d.value));
---

<BaseLayout title={project.data.title} description={`Proyecto ${project.data.title} ejecutado por Innovatech${project.data.location ? ` en ${project.data.location}` : ''}.`}>
  {/* Hero */}
  <section class="py-16 sm:py-20 bg-background border-b-brutal">
    <Container>
      <Breadcrumbs items={[
        { label: 'Inicio', href: '/' },
        { label: 'Proyectos', href: '/proyectos' },
        { label: project.data.title },
      ]} />
      <Badge variant="primary" class="mb-4">{categoryLabels[project.data.category]}</Badge>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black uppercase text-neutral-950 tracking-tight leading-tight mb-4">
        {project.data.title}
      </h1>
    </Container>
  </section>

  {/* Project images — React Lightbox Island */}
  <section class="border-b-brutal">
    <Container>
      <div class="my-8">
        <ProjectGallery client:visible images={images} alt={project.data.title} />
      </div>
    </Container>
  </section>

  {/* Details + Content */}
  <section class="py-section">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        {/* Sidebar */}
        <div class="lg:col-span-1 order-2 lg:order-1">
          <div class="sticky top-28 bg-surface-alt border-brutal p-6 space-y-4">
            <h3 class="font-bold uppercase text-neutral-950 mb-2">Datos del proyecto</h3>
            {details.map((d) => (
              <div>
                <div class="text-xs text-neutral-500 uppercase tracking-wider">{d.label}</div>
                <div class="text-sm font-medium text-neutral-900">{d.value}</div>
              </div>
            ))}
            <div class="pt-4">
              <Button href="/cotizador" size="sm" class="w-full justify-center">
                Cotizar proyecto similar
              </Button>
            </div>
          </div>
        </div>

        {/* Content */}
        <div class="lg:col-span-2 order-1 lg:order-2">
          <div class="prose prose-neutral prose-lg max-w-none prose-headings:font-bold prose-headings:tracking-tight">
            <Content />
          </div>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
