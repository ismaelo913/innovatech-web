---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import ProjectFilter from '../../components/projects/ProjectFilter.tsx';
import CTASection from '../../components/home/CTASection.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { responsivePhoto } from '../../lib/projectPhotos';

const rawProjects = (await getCollection('projects')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

// Portada de cada proyecto (archivos en src/assets/projects)
const projectImages: Record<string, string> = {
  'condominio-colina':              'colina-1.jpeg',
  'condominio-las-condes':          'las-condes-1.jpeg',
  'techumbre-terminaciones':        'techumbre-1.jpeg',
  'mina-cmp-copiapo':               'mina-cmp-1.jpeg',
  'tableros-electricos-armados':    'tableros-1.jpeg',
  'montaje-electrico-industrial':   'montaje-electrico-1.jpeg',
};

const categoryLabels: Record<string, string> = {
  'remodelacion-residencial': 'Remodelación Residencial',
  'remodelacion-comercial':   'Remodelación Comercial',
  'obra-gruesa':              'Obra Gruesa',
  'terminaciones':            'Terminaciones',
  'ampliacion':               'Ampliación',
  'montaje-electrico':        'Montaje Eléctrico',
};

// Serialize projects for the React island
const projects = await Promise.all(rawProjects.map(async (p) => ({
  id: p.id,
  title: p.data.title,
  category: p.data.category,
  location: p.data.location || undefined,
  image: await responsivePhoto(projectImages[p.id] || 'colina-1.jpeg', [400, 800]),
})));
---

<BaseLayout
  title="Proyectos"
  description="Proyectos de construcción ejecutados por Innovatech en Santiago. Calidad que se ve, seguridad que se siente."
>
  <div class="bg-background border-b-brutal">
    <Container>
      <div class="pt-4">
        <Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: 'Proyectos' }]} />
      </div>
    </Container>
  </div>

  <section class="py-16 sm:py-20 bg-background border-b-brutal">
    <Container>
      <SectionHeading
        label="Portafolio"
        title="Proyectos que reflejan nuestro compromiso"
        description="Cada obra es una oportunidad de demostrar que la calidad y la seguridad hacen la diferencia."
      />
    </Container>
  </section>

  <section class="py-section">
    <Container>
      <ProjectFilter client:load projects={projects} categoryLabels={categoryLabels} />
    </Container>
  </section>

  <CTASection />
</BaseLayout>
