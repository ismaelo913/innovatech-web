---
interface Props {
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost' | 'accent';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  class?: string;
  [key: string]: any;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  class: className,
  ...rest
} = Astro.props;

const baseStyles = 'inline-flex items-center justify-center font-bold transition-colors duration-300 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500';

const variants: Record<string, string> = {
  primary:
    'rounded-2xl bg-primary-600 text-white hover:bg-neutral-950 active:bg-neutral-900 shadow-lg shadow-primary-600/20',
  secondary:
    'rounded-none border-brutal bg-neutral-950 text-white hover:bg-primary-600',
  outline:
    'rounded-none border-brutal bg-transparent text-neutral-950 hover:bg-neutral-950 hover:text-white',
  ghost:
    'rounded-none text-neutral-700 hover:bg-neutral-100 active:bg-neutral-200',
  accent:
    'rounded-none border-brutal bg-accent-600 text-white hover:bg-neutral-950',
};

const sizes: Record<string, string> = {
  sm: 'text-sm px-3.5 py-2 gap-1.5',
  md: 'text-base px-5 py-2.5 gap-2',
  lg: 'text-lg px-7 py-3.5 gap-2.5',
};

const classes = `${baseStyles} ${variants[variant]} ${sizes[size]} ${className ?? ''}`;
const Tag = href ? 'a' : 'button';
---

<Tag href={href} class={classes} {...rest}>
  <slot />
</Tag>
