---
// Marcas de registro tipo plano técnico (crosshair + tick) en las 4 esquinas
// del contenedor padre. El padre debe ser `relative`. `variant` controla el
// color de trazo para fondos claros u oscuros.
interface Props {
  variant?: 'light' | 'dark';
  class?: string;
}
const { variant = 'light', class: className } = Astro.props;
const stroke = variant === 'dark' ? 'stroke-white/25' : 'stroke-neutral-950/20';
---

<div class:list={['pointer-events-none absolute inset-0', className]} aria-hidden="true">
  {[
    'top-3 left-3',
    'top-3 right-3 -scale-x-100',
    'bottom-3 left-3 -scale-y-100',
    'bottom-3 right-3 -scale-x-100 -scale-y-100',
  ].map((pos) => (
    <svg
      viewBox="0 0 28 28"
      class:list={['absolute w-5 h-5 sm:w-6 sm:h-6', stroke, ...pos.split(' ')]}
      fill="none"
      stroke-width="1"
    >
      <path d="M0,8 L0,0 L8,0" />
      <circle cx="14" cy="14" r="3.5" />
      <path d="M14,7 L14,10.5 M14,17.5 L14,21 M7,14 L10.5,14 M17.5,14 L21,14" />
    </svg>
  ))}
</div>
