---
interface Props {
  variant?: 'default' | 'primary' | 'accent';
  class?: string;
}

const { variant = 'default', class: className } = Astro.props;

const variants: Record<string, string> = {
  default: 'border-brutal text-neutral-950',
  primary: 'border-brutal bg-primary-600 text-white',
  accent: 'border-brutal bg-accent-600 text-white',
};
---

<span
  class:list={[
    'inline-flex items-center px-3 py-1 text-xs font-bold uppercase tracking-widest',
    variants[variant],
    className,
  ]}
>
  <slot />
</span>
