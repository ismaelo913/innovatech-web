---
interface Props {
  label?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  dark?: boolean;
  class?: string;
}

const {
  label,
  title,
  description,
  align = 'center',
  dark = false,
  class: className,
} = Astro.props;

const alignClass = align === 'center' ? 'text-center mx-auto' : 'text-left';
---

<div class:list={['max-w-2xl mb-12', alignClass, className]}>
  {label && (
    <span
      class:list={[
        'inline-block text-sm font-bold tracking-widest uppercase mb-4',
        dark ? 'text-primary-400' : 'text-primary-600',
      ]}
    >
      {label}
    </span>
  )}
  <h2
    class:list={[
      'font-display text-4xl sm:text-5xl font-black uppercase leading-tight',
      dark ? 'text-background' : 'text-neutral-950',
    ]}
  >
    {title}
  </h2>
  {description && (
    <p
      class:list={[
        'mt-4 text-lg font-light leading-relaxed',
        dark ? 'text-neutral-400' : 'text-accent-500',
      ]}
    >
      {description}
    </p>
  )}
</div>
