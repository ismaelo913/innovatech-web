---
// Tarjeta de servicio destacado — a todo ancho, con foto de fondo. Reservada
// para el servicio de mayor prioridad de negocio (electricidad y montaje
// eléctrico): debe ser lo primero y más llamativo que se vea en /servicios
// y en el home.
interface Props {
  title: string;
  short: string;
  slug: string;
  image: string;
}
const { title, short, slug, image } = Astro.props;
---

<a href={`/servicios/${slug}`} class="group reveal block relative overflow-hidden border-b-brutal min-h-[60vh]">
  <img
    src={image}
    alt={`${title} — Innovatech`}
    width="1280"
    height="720"
    class="absolute inset-0 w-full h-full object-cover grayscale-[30%] transition-all duration-[1.5s] group-hover:scale-105 group-hover:grayscale-0"
    loading="lazy"
    decoding="async"
  />
  <div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-neutral-950/60 to-transparent"></div>
  <div class="relative h-full flex flex-col md:flex-row md:items-end md:justify-between gap-6 p-6 sm:p-8 lg:p-12 min-h-[60vh]">
    <div class="text-white max-w-2xl">
      <span class="bg-primary-600 text-white text-[10px] uppercase font-bold px-3 py-1 mb-4 inline-block tracking-widest">Servicio destacado</span>
      <h3 class="font-display text-4xl sm:text-5xl lg:text-6xl font-black uppercase leading-tight mb-4">
        {title}
      </h3>
      <p class="text-base sm:text-lg text-white/80 font-light max-w-xl leading-relaxed">
        {short}
      </p>
    </div>
    <div class="flex-shrink-0 flex items-center gap-3 text-white group-hover:text-primary-400 transition-colors">
      <span class="text-sm font-bold uppercase tracking-widest">Ver más</span>
      <div class="w-11 h-11 border-brutal-invert flex items-center justify-center shrink-0">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </div>
    </div>
  </div>
</a>
