---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';

const frames = [
  {
    title: 'Mina CMP Copiapó — Planta Pellet',
    category: 'Montaje Eléctrico',
    location: 'Copiapó, Atacama',
    image: '/images/projects/mina-cmp-1.jpeg',
    slug: 'mina-cmp-copiapo',
  },
  {
    title: 'Montaje Eléctrico Industrial',
    category: 'Montaje Eléctrico',
    location: 'Región Metropolitana',
    image: '/images/projects/montaje-electrico-2.jpeg',
    slug: 'montaje-electrico-industrial',
  },
  {
    title: 'Techumbre y Terminaciones',
    category: 'Obra Gruesa',
    location: null,
    image: '/images/projects/techumbre-1.jpeg',
    slug: 'techumbre-terminaciones',
  },
];
---

<section class="relative bg-neutral-950 texture-grain border-y-brutal-invert projects-pin-wrapper">
  <div class="sticky top-0 h-screen flex items-center overflow-hidden">
    <Container>
      <div class="grid lg:grid-cols-[1.1fr_0.9fr] gap-10 lg:gap-16 items-center">
        <div class="relative aspect-[4/3] sm:aspect-[16/10] overflow-hidden border-brutal-invert">
          {frames.map((frame, i) => (
            <a
              href={`/proyectos/${frame.slug}`}
              class="project-frame absolute inset-0 block"
              style={`opacity: ${i === 0 ? 1 : 0}`}
              data-frame={i}
            >
              <img
                src={frame.image}
                alt={frame.title}
                width="1280"
                height="800"
                class="absolute inset-0 w-full h-full object-cover"
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-neutral-950/85 via-transparent to-transparent"></div>
              <div class="absolute bottom-0 left-0 right-0 p-5 sm:p-6">
                <span class="inline-flex items-center px-3 py-1 text-xs font-bold uppercase tracking-widest bg-primary-600 text-white mb-2">
                  {frame.category}
                </span>
                <h3 class="text-lg sm:text-xl font-black text-white">{frame.title}</h3>
                {frame.location && <p class="text-sm text-neutral-300 font-light mt-1">{frame.location}</p>}
              </div>
            </a>
          ))}
        </div>

        <div>
          <span class="inline-flex items-center gap-2 text-xs font-bold tracking-[0.2em] uppercase text-primary-500 mb-4">
            <span class="w-6 h-px bg-primary-500"></span>
            Proyectos
          </span>
          <h2 class="font-display text-4xl sm:text-5xl font-black uppercase text-white leading-tight mb-5">
            Nuestro trabajo, nuestra carta de presentación
          </h2>
          <p class="text-neutral-400 font-light text-lg leading-relaxed mb-8 max-w-md">
            Cada obra refleja el estándar de calidad y seguridad que nos define. Constructoras, inmobiliarias y empresas del sector industrial confían en nosotros.
          </p>
          <Button href="/proyectos" variant="ghost" class="!text-neutral-300 border-brutal-invert uppercase tracking-wide hover:!text-white hover:!bg-white/5">
            Ver todos los proyectos
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </Button>

          <div class="flex gap-2 mt-10">
            {frames.map((_, i) => (
              <span class="project-dot h-1 bg-white/15 transition-all duration-300" data-dot={i} style={`width: ${i === 0 ? '2rem' : '0.75rem'}`}></span>
            ))}
          </div>
        </div>
      </div>
    </Container>
  </div>
</section>

<style>
  .projects-pin-wrapper {
    height: 280vh;
  }
  @media (prefers-reduced-motion: reduce) {
    .projects-pin-wrapper {
      height: auto;
    }
    .projects-pin-wrapper .sticky {
      position: static;
      height: auto;
      padding: 4rem 0;
    }
    .project-frame {
      position: relative !important;
      opacity: 1 !important;
      margin-bottom: 1rem;
    }
  }
</style>

