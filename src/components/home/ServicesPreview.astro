---
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import FeaturedServiceCard from '../services/FeaturedServiceCard.astro';
import { SERVICES } from '../../lib/constants';

const featured = SERVICES.find((s) => s.slug === 'electricidad-montaje-electrico');
const rest = SERVICES.filter((s) => s.slug !== 'electricidad-montaje-electrico');
---

<section class="border-b-brutal pt-section">
  <Container class="mb-16">
    <SectionHeading
      align="left"
      label="Servicios"
      title="Calidad en cada etapa de tu obra"
      description="Desde la estructura hasta el último detalle, nuestro equipo trabaja con el cuidado que tu proyecto merece."
      class="mx-0"
    />
  </Container>

  <div class="border-t-brutal">
    {featured && (
      <FeaturedServiceCard title={featured.title} short={featured.short} slug={featured.slug} image="/images/projects/montaje-electrico-1.jpeg" />
    )}

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 border-l-brutal">
      {rest.map((service, i) => (
        <a
          href={`/servicios/${service.slug}`}
          class:list={[
            'group block reveal h-full border-r-brutal border-b-brutal hover-bg-brand p-8 flex flex-col',
            i === 0 && 'sm:col-span-2 bg-primary-50/60',
          ]}
        >
          <h3 class:list={['font-bold mb-4', i === 0 ? 'text-2xl sm:text-3xl' : 'text-xl']}>
            {service.title}
          </h3>
          <p class:list={['font-light text-accent-500 leading-relaxed flex-grow mb-8', i === 0 ? 'text-base max-w-md' : 'text-sm']}>
            {service.short}
          </p>
          <div class="mt-auto flex items-center gap-2 text-sm font-bold uppercase tracking-wider">
            Ver más
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

