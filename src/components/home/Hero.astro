---
import Button from '../ui/Button.astro';
---

<section class="border-b-brutal">
  <div class="grid grid-cols-1 lg:grid-cols-12">
    <!-- Left: headline + copy -->
    <div class="lg:col-span-6 p-8 sm:p-12 lg:p-16 flex flex-col justify-center border-b-brutal lg:border-b-0 lg:border-r-brutal bg-background min-h-[55vh] lg:min-h-[85vh]">
      <div class="reveal delay-100">
        <span class="inline-flex items-center gap-2 text-xs font-bold tracking-[0.2em] uppercase text-primary-600 mb-6">
          <span class="w-6 h-px bg-primary-600"></span>
          Construcción y Montaje Eléctrico · Santiago RM
        </span>
      </div>

      <h1
        id="hero-headline"
        data-splitting
        style="opacity:0"
        class="text-4xl sm:text-5xl lg:text-6xl font-black uppercase tracking-tight text-neutral-950 leading-[0.95] mb-6"
      >
        Obra eléctrica y construcción sin <span class="text-primary-600">el riesgo de siempre</span>
      </h1>

      <p id="hero-sub" style="opacity:0" class="text-lg sm:text-xl font-light text-accent-500 max-w-xl mb-10 leading-relaxed">
        Precio por escrito antes de empezar, supervisor presente todos los días, sin anticipo exagerado. Ejecutamos obra gruesa, montaje eléctrico y salas eléctricas en Santiago — y sí, terminamos lo que empezamos.
      </p>
      <noscript><style>#hero-headline, #hero-sub { opacity: 1 !important; }</style></noscript>

      <div class="reveal delay-400 flex flex-col sm:flex-row gap-4">
        <Button href="/cotizador" size="lg" variant="primary" id="hero-a-cta-primary">
          Cotiza tu proyecto
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </Button>
        <Button
          href="/servicios"
          size="lg"
          variant="outline"
          id="hero-a-cta-secondary"
        >
          Conoce nuestros servicios
        </Button>
      </div>
    </div>

    <!-- Right: photo collage — obra real, no stock -->
    <div class="lg:col-span-6 bg-surface-alt relative min-h-[50vh] lg:min-h-[85vh] overflow-hidden flex items-center justify-center p-8">
      <div class="reveal-scale delay-300 relative w-full max-w-md lg:max-w-none">
        <div class="relative aspect-[4/5] sm:aspect-[5/4] lg:aspect-[4/5]">
          <div class="absolute inset-0 lg:inset-x-6 img-reveal-container border-brutal -rotate-2 bg-background">
            <img
              src="/images/projects/mina-cmp-1.jpeg"
              alt="Montaje eléctrico en faena minera — Mina CMP Copiapó, Innovatech"
              width="540"
              height="960"
              class="w-full h-full object-cover"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>
          <div class="absolute -bottom-6 -left-2 sm:-left-6 w-[42%] aspect-[3/4] img-reveal-container border-brutal rotate-3 bg-background">
            <img
              src="/images/projects/mina-cmp-9.jpeg"
              alt="Instalación de equipos de alta tensión — Mina CMP Copiapó, Innovatech"
              width="720"
              height="1280"
              class="w-full h-full object-cover"
              loading="eager"
              decoding="async"
            />
          </div>
          <div class="absolute -top-4 -right-2 sm:right-2 bg-primary-600 text-white text-xs sm:text-sm font-bold uppercase tracking-wide px-3 py-2 border-brutal rotate-2">
            13 años en terreno
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Stats band: marquee ticker + CountUp — datos reales del Portafolio Innovatech.pdf -->
  <div class="bg-neutral-950 text-background">
    <div class="marquee-container py-3 border-b-brutal-invert">
      <div class="marquee-content text-primary-500 uppercase tracking-[0.2em] text-xs font-bold flex gap-12">
        {Array.from({ length: 10 }).map(() => <span>13 años en terreno</span>)}
      </div>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 divide-x divide-y md:divide-y-0 divide-white/15 reveal delay-500">
      <div class="p-6 lg:p-10">
        <div class="text-3xl lg:text-5xl font-black countup" data-target="13" data-suffix=" años">0 años</div>
        <div class="text-xs uppercase tracking-widest text-neutral-500 mt-1">De experiencia</div>
      </div>
      <div class="p-6 lg:p-10">
        <div class="text-3xl lg:text-5xl font-black countup" data-target="60" data-suffix="+">0+</div>
        <div class="text-xs uppercase tracking-widest text-neutral-500 mt-1">Trabajadores disponibles</div>
      </div>
      <div class="p-6 lg:p-10">
        <div class="text-3xl lg:text-5xl font-black countup" data-target="6" data-suffix="">0</div>
        <div class="text-xs uppercase tracking-widest text-neutral-500 mt-1">Tipos de servicio</div>
      </div>
      <div class="p-6 lg:p-10">
        <div class="text-3xl lg:text-5xl font-black countup" data-target="100" data-suffix="%" data-prefix="">0%</div>
        <div class="text-xs uppercase tracking-widest text-neutral-500 mt-1">Cumplimiento legal</div>
      </div>
    </div>
  </div>
</section>

