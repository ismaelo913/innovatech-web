---
import Button from '../ui/Button.astro';
import BlueprintMarks from '../ui/BlueprintMarks.astro';
import { SITE } from '../../lib/constants';
import { whatsappUrl } from '../../lib/utils';

const waUrl = whatsappUrl(SITE.whatsapp, 'Hola, me interesa cotizar un proyecto con Innovatech.');
---

<section class="border-b-brutal grid grid-cols-1 lg:grid-cols-2">
  <!-- Main CTA -->
  <div class="p-8 lg:p-20 flex flex-col justify-center border-b-brutal lg:border-b-0 lg:border-r-brutal bg-background">
    <h2 class="font-display text-5xl sm:text-6xl lg:text-7xl font-black uppercase leading-tight text-neutral-950 mb-8 max-w-xl">
      Hablemos de tu próximo proyecto
    </h2>
    <p class="text-lg font-light text-accent-500 mb-10 max-w-md leading-relaxed">
      Cuéntanos qué necesitas y te orientamos sin compromiso. Nos gusta construir relaciones antes de construir obras.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 mb-8">
      <Button href="/cotizador" size="lg" variant="primary">
        Solicitar cotización
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </Button>
      <Button href="/contacto" size="lg" variant="outline">
        Contactar directamente
      </Button>
    </div>
    <a href={waUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-[#25D366] font-bold text-lg hover:text-neutral-950 transition-colors w-fit">
      <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
      Contactar por WhatsApp
    </a>
  </div>

  <!-- Lead magnet: checklist mandante -->
  <div class="p-8 lg:p-20 bg-neutral-950 texture-grain text-white flex flex-col justify-center relative overflow-hidden">
    <BlueprintMarks variant="dark" />
    <div class="relative z-10">
      <div class="inline-block bg-primary-600 text-white px-4 py-2 font-bold uppercase tracking-widest text-xs mb-8">Recurso Gratuito</div>
      <h3 class="text-3xl lg:text-4xl font-black uppercase mb-6 leading-tight">¿Contratando Subcontratistas?</h3>
      <p class="text-lg font-light text-white/80 mb-10 max-w-md">Evita multas laborales de hasta 150 UTM. Descarga gratis el checklist de control de obra en Chile.</p>
      <a
        href="/recursos/checklist-subcontratistas"
        class="border-brutal-invert px-8 py-4 text-base font-bold uppercase tracking-wide hover:bg-white hover:text-neutral-950 transition-colors inline-flex items-center gap-3 w-fit"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        Ver Checklist Gratis
      </a>
    </div>
  </div>
</section>
