---
import { Image } from 'astro:assets';
import Container from '../ui/Container.astro';
import { CLIENTS, logoSize } from '../../lib/clients';
---

<section class="border-b-brutal bg-surface-alt pt-section pb-section">
  <Container class="mb-16 text-center max-w-3xl">
    <p class="reveal text-sm font-bold tracking-widest uppercase text-primary-700 mb-4">
      13 años de trayectoria
    </p>
    <h2 class="reveal font-display text-4xl sm:text-5xl font-black uppercase leading-tight text-neutral-950">
      Han confiado en nosotros
    </h2>
    <p class="reveal text-lg font-light text-accent-500 mt-4">
      Minería, distribuidoras eléctricas, constructoras e inmobiliarias para las que hemos ejecutado y supervisado obra en Santiago y regiones.
    </p>
  </Container>

  <!-- Logo grid — lattice de bordes duros; cada logo con la misma superficie (lib/clients.ts) -->
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 border-t-brutal border-l-brutal bg-white reveal">
    {CLIENTS.map((c) => {
      const size = logoSize(c.logo, 80, 190);
      return (
        <div class="border-r-brutal border-b-brutal p-4 flex items-center justify-center min-h-[160px]">
          <Image
            src={c.logo}
            alt={`Logo ${c.nombre}`}
            width={size.width}
            height={size.height}
            densities={[1, 2]}
            class="max-w-[85%] h-auto object-contain client-logo"
            loading="lazy"
            decoding="async"
          />
        </div>
      );
    })}
  </div>
</section>
