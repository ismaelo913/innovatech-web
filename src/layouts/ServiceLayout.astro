---
import BaseLayout from './BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
// ElectricalPulseScene: deshabilitado temporalmente (2026-08-15). El componente
// compila y funciona bien en local (build limpio, verificado con Playwright),
// pero rompe el build en el entorno de Vercel específicamente con un error de
// parseo de esbuild ("Expected ':' but found ')'" en el chunk bundleado) que no
// se pudo reproducir localmente pese a igualar versión de Node, versión de
// esbuild, variables de entorno VERCEL/CI y build sin cache. Para no bloquear
// el resto de las Fases 0-4, se desactiva aquí. El archivo del componente
// sigue en src/components/three/ElectricalPulseScene.tsx para retomarlo.
// import ElectricalPulseScene from '../components/three/ElectricalPulseScene';
import { SERVICES, SITE } from '../lib/constants';
import { comunaLandingsFor } from '../lib/comunas';

interface Props {
  title: string;
  description: string;
  icon: string;
  features: string[];
  slug: string;
}

const { title, description, icon, features, slug } = Astro.props;

const otherServices = SERVICES.filter((s) => s.slug !== slug);
// Sin este enlace, las páginas por comuna solo eran visibles vía sitemap.
const comunaLandings = comunaLandingsFor(slug);

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: title,
  description,
  serviceType: title,
  provider: {
    '@type': 'LocalBusiness',
    name: SITE.fullName,
    url: SITE.url,
  },
  areaServed: {
    '@type': 'City',
    name: 'Santiago',
    containedInPlace: { '@type': 'State', name: 'Región Metropolitana' },
  },
  url: new URL(`/servicios/${slug}`, SITE.url).href,
};
---

<BaseLayout title={title} description={description} schema={serviceSchema}>
  {/* Hero */}
  <section class="py-16 sm:py-20 bg-background border-b-brutal">
    <Container>
      <div class="max-w-3xl">
        <Breadcrumbs items={[
          { label: 'Inicio', href: '/' },
          { label: 'Servicios', href: '/servicios' },
          { label: title },
        ]} />
        <Badge variant="primary" class="mb-4">{title}</Badge>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black uppercase text-neutral-950 tracking-tight leading-tight mb-4">
          {title}
        </h1>
        <p class="text-lg font-light text-accent-500 leading-relaxed">
          {description}
        </p>
      </div>
    </Container>
  </section>

  {/* Features */}
  <section class="py-12 border-b-brutal">
    <Container>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {features.map((f) => (
          <div class="flex items-start gap-3 p-4 border-brutal bg-background">
            <svg class="w-5 h-5 text-primary-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="text-sm font-medium text-neutral-700">{f}</span>
          </div>
        ))}
      </div>
    </Container>
  </section>

  {/* Content */}
  <section class="py-section">
    <Container narrow>
      <div class="prose prose-neutral prose-lg max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-a:text-primary-600 prose-a:no-underline hover:prose-a:underline">
        <slot />
      </div>
    </Container>
  </section>

  {/* Comunas con página propia para este servicio */}
  {comunaLandings.length > 0 && (
    <section class="py-12 border-t-brutal">
      <Container>
        <h2 class="text-2xl font-black uppercase text-neutral-950 mb-2">{title} en tu comuna</h2>
        <p class="text-sm text-accent-500 mb-6">
          Trabajamos en toda la Región Metropolitana. Revisa lo que ejecutamos en estas comunas:
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {comunaLandings.map((landing) => (
            <a
              href={`/servicios/${slug}/${landing.comunaSlug}`}
              class="flex items-center gap-3 p-4 border-brutal bg-white hover-bg-brand group"
            >
              <div class="w-10 h-10 border-brutal bg-primary-50 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                </svg>
              </div>
              <div>
                <div class="text-sm font-semibold text-neutral-900">{title} en {landing.comuna}</div>
                <div class="text-xs text-neutral-600 line-clamp-1">{landing.projectTypes[0]}</div>
              </div>
            </a>
          ))}
        </div>
      </Container>
    </section>
  )}

  {/* CTA */}
  <section class="py-16 bg-primary-600">
    <Container>
      <div class="flex flex-col sm:flex-row items-center justify-between gap-6">
        <div>
          <h2 class="text-2xl font-bold text-white mb-2">
            ¿Te interesa este servicio?
          </h2>
          <p class="text-white">
            Cuéntanos sobre tu proyecto y te orientamos sin compromiso.
          </p>
        </div>
        <Button href="/cotizador" size="lg" variant="accent" class="shrink-0">
          Cotizar ahora
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </Button>
      </div>
    </Container>
  </section>

  {/* Other services */}
  <section class="py-section bg-surface-alt">
    <Container>
      <h2 class="text-2xl font-black uppercase text-neutral-950 mb-8">Otros servicios</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {otherServices.map((s) => (
          <a
            href={`/servicios/${s.slug}`}
            class="flex items-center gap-3 p-4 border-brutal bg-white hover-bg-brand group"
          >
            <div class="w-10 h-10 border-brutal bg-primary-50 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </div>
            <div>
              <div class="text-sm font-semibold text-neutral-900">{s.title}</div>
              <div class="text-xs text-neutral-500 line-clamp-1">{s.short}</div>
            </div>
          </a>
        ))}
      </div>
    </Container>
  </section>
</BaseLayout>
