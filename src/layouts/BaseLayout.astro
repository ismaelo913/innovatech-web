---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import WhatsAppButton from '../components/layout/WhatsAppButton.astro';
import B2BBanner from '../components/layout/B2BBanner.astro';
import Analytics from '@vercel/analytics/astro';
import { Font } from 'astro:assets';
import '../styles/global.css';
import { SITE } from '../lib/constants';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  schema?: Record<string, unknown>;
  /**
   * Fuentes que usa la página además de Inter (clases font-display,
   * font-stencil, font-mono), para precargarlas. Ver <Font> más abajo.
   */
  fonts?: Array<'display' | 'stencil' | 'mono'>;
  /** Carga GSAP + ScrollTrigger + CustomEase (solo la home los usa). */
  gsap?: boolean;
  /** Artículos del blog: se comparten como og:type "article" con su fecha. */
  article?: { publishedTime: Date };
}

const {
  title = SITE.name,
  description = SITE.description,
  ogImage = '/images/og-default.jpg',
  schema,
  fonts = [],
  gsap = false,
  article,
} = Astro.props;

const pageTitle = title === SITE.name ? title : `${title} | ${SITE.name}`;
const canonicalUrl = new URL(Astro.url.pathname, SITE.url);
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {article && <meta property="article:published_time" content={article.publishedTime.toISOString()} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL(ogImage, SITE.url)} />
    <meta property="og:site_name" content={SITE.fullName} />
    <meta property="og:locale" content="es_CL" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <!-- Fuentes auto-hospedadas (config `fonts` en astro.config.mjs): el
         @font-face va incrustado y cada familia es un solo archivo variable.
         Se precargan solo las que usa la página (Inter siempre, el resto
         según el prop `fonts`): igual se descargarían al primer layout, pero
         precargadas llegan antes del primer pintado —sin salto al cambiar de
         fuente— y con prioridad alta en vez de "muy alta", que Lighthouse
         trata como bloqueante. Los respaldos locales vienen ajustados a las
         métricas de cada fuente. -->
    <Font cssVariable="--font-inter" preload />
    <!-- Display industrial: solo para H1/H2 — evoca vigas de acero / marcaje de fábrica -->
    <Font cssVariable="--font-big-shoulders" preload={fonts.includes('display')} />
    <Font cssVariable="--font-big-shoulders-stencil" preload={fonts.includes('stencil')} />
    <Font cssVariable="--font-jetbrains-mono" preload={fonts.includes('mono')} />

    <!-- Animation libs auto-hospedadas en /public/vendor (2026-08-15): antes
         se cargaban desde cdnjs/jsdelivr. Se mantienen como <script> clásicos
         (no import npm en el bundle) a propósito — esa fue la causa documentada
         de fallos de build intermitentes en Vercel al intentar que esbuild las
         empaquetara para el entrypoint del servidor. Auto-hospedarlas como
         estáticos resuelve la dependencia de un CDN externo (punto único de
         falla, riesgo de bloqueadores de contenido) sin tocar el pipeline de
         build: son los mismos binarios .min.js (versión fijada, ver
         public/vendor/README.txt), solo que servidos desde el propio dominio.
         Solo se cargan donde se usan: GSAP en las páginas con el prop `gsap`
         (la home); Lenis y VanillaTilt bajo demanda y solo en escritorio (ver
         src/scripts/load-vendor.js). Antes las cinco se descargaban en todas
         las páginas, también en móvil, donde Lenis y el tilt no corren. -->
    {gsap && (
      <>
        <script defer src="/vendor/gsap.min.js"></script>
        <script defer src="/vendor/ScrollTrigger.min.js"></script>
        <!-- CustomEase: registra las curvas propias "de precisión industrial" (ver src/scripts/eases.js) -->
        <script defer src="/vendor/CustomEase.min.js"></script>
      </>
    )}

    <!-- Favicon: Google Search pide un ícono cuadrado de 48×48 px o múltiplo
         de 48 (antes solo había un .ico de 16×16). Recorte ajustado al logo. -->
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png?v=3" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png?v=3" />
    <link rel="icon" href="/favicon.ico?v=3" sizes="any" />
    <link rel="apple-touch-icon" href="/favicon-192.png?v=3" />

    <!-- Theme Color -->
    <meta name="theme-color" content="#e8730c" />

    <!-- Microsoft Clarity: se carga cuando la página ya terminó de cargar, para
         que no compita con el contenido. La cola `clarity(...)` existe desde
         el inicio, así que las llamadas previas no se pierden. -->
    <script type="text/javascript">
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        function load(){
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        }
        function idle(){ c.requestIdleCallback ? c.requestIdleCallback(load, { timeout: 3000 }) : setTimeout(load, 1); }
        if (l.readyState === 'complete') idle(); else c.addEventListener('load', idle);
      })(window, document, "clarity", "script", "wkz71eh3u9");
    </script>

    <!-- Google Analytics 4: se activa solo si PUBLIC_GA4_MEASUREMENT_ID está
         definido en las variables de entorno de Vercel (Project Settings →
         Environment Variables). Mientras no exista, este bloque no renderiza
         nada — no se envían eventos vacíos ni se rompe nada por su ausencia.
         Crear la propiedad GA4 y pegar el Measurement ID (formato G-XXXXXXX)
         requiere la cuenta de Google del negocio, así que ese paso queda para
         el equipo de Innovatech. -->
    {import.meta.env.PUBLIC_GA4_MEASUREMENT_ID && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${import.meta.env.PUBLIC_GA4_MEASUREMENT_ID}`}></script>
        <script define:vars={{ gaId: import.meta.env.PUBLIC_GA4_MEASUREMENT_ID }}>
          window.dataLayer = window.dataLayer || [];
          // En window y no como `function gtag()`: define:vars envuelve este
          // script en una función, y los eventos de conversión
          // (src/lib/analytics.ts) necesitan llamar a gtag desde afuera.
          window.gtag = function gtag(){ dataLayer.push(arguments); };
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}

    <!-- Structured Data: Page-specific -->
    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}

    <!-- Structured Data: LocalBusiness / GeneralContractor -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": ["LocalBusiness", "GeneralContractor"],
      "name": SITE.fullName,
      "alternateName": SITE.name,
      "description": SITE.description,
      "url": SITE.url,
      "telephone": SITE.phone,
      "email": SITE.email,
      "sameAs": [SITE.socials.linkedin, SITE.socials.instagram],
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Santiago",
        "addressRegion": "Región Metropolitana",
        "addressCountry": "CL"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": -33.4489,
        "longitude": -70.6693
      },
      "areaServed": ["Santiago", "Región Metropolitana"],
      "image": new URL("/images/logo/logo-full.jpeg", SITE.url).href,
      "logo": new URL("/images/logo/logo-square.png", SITE.url).href,
      "openingHoursSpecification": [{
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
        "opens": "08:00",
        "closes": "18:00"
      }],
      "slogan": SITE.tagline,
      "serviceArea": {
        "@type": "GeoCircle",
        "geoMidpoint": { "@type": "GeoCoordinates", "latitude": -33.4489, "longitude": -70.6693 },
        "geoRadius": "50000"
      },
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Servicios de Construcción",
        "itemListElement": [
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Electricidad y Montaje Eléctrico" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Obra Gruesa" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Terminaciones" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Ampliaciones" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Remodelaciones Comerciales" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Remodelaciones Residenciales" } }
        ]
      }
    })} />
  </head>
  <body class="min-h-screen flex flex-col bg-background text-text">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-primary-600 focus:text-white focus:rounded-lg">
      Saltar al contenido principal
    </a>

    <Header />

    <main id="main-content" class="flex-1 pt-18 lg:pt-20">
      <slot />
    </main>

    <Footer />
    <WhatsAppButton />
    <B2BBanner />
    <Analytics />

    <!-- Scroll Reveal: vanilla JS, all devices -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const reveal = (el: Element) => el.classList.add('is-visible');

        // Fix (2026-08-15): elementos .reveal* que ya están dentro del
        // viewport en el primer pintado (ej. el collage de fotos del hero)
        // podían quedar en opacity:0 "para siempre" hasta el primer scroll
        // del usuario, porque dependían por completo del primer callback
        // asíncrono del IntersectionObserver. Verificado en vivo: el wrapper
        // .reveal-scale del hero permanecía sin la clase is-visible incluso
        // 5s después de cargar sin ninguna interacción. Ahora, si el elemento
        // ya es visible al momento de observarlo, lo revelamos de inmediato
        // en vez de esperar al observer — el observer sigue a cargo de todo
        // lo que está debajo del pliegue.
        const isAlreadyVisible = (el: Element) => {
          const rect = el.getBoundingClientRect();
          const vh = window.innerHeight || document.documentElement.clientHeight;
          const vw = window.innerWidth || document.documentElement.clientWidth;
          if (rect.width === 0 && rect.height === 0) return false;
          return rect.top < vh * 0.92 && rect.bottom > 0 && rect.left < vw && rect.right > 0;
        };

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              reveal(entry.target);
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });

        document.querySelectorAll('.reveal, .reveal-left, .reveal-right, .reveal-scale').forEach((el) => {
          if (isAlreadyVisible(el)) {
            reveal(el);
          } else {
            observer.observe(el);
          }
        });
      });
    </script>

    <!-- Lenis smooth scroll: dynamic import, init solo en desktop, respeta prefers-reduced-motion -->
    <script src="../scripts/lenis-init.js"></script>

    <!-- Conversiones GA4: clics a WhatsApp / teléfono / email (no hace nada si GA4 no está cargado) -->
    <script>
      import { trackContactLinks } from '../lib/analytics';
      trackContactLinks();
    </script>
  </body>
</html>

